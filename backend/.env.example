# App Configuration
APP_NAME=Marketing Manager - Google Ads
APP_VERSION=0.1.0
DEBUG=False
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/marketing_manager
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# JWT & Auth
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Google OAuth2 (do google-ads-manager)
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=https://seu-dominio.com/api/v1/auth/google/callback

# Google Ads API (do google-ads-manager)
GOOGLE_ADS_DEVELOPER_TOKEN=seu_developer_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=seu_login_customer_id

# OpenAI (para recomendações IA)
OPENAI_API_KEY=sua_chave_openai
OPENAI_MODEL=gpt-4o

# n8n (opcional para automações)
N8N_API_URL=https://seu-n8n-instance.com/api/v1
N8N_API_KEY=sua_chave_api_n8n

# Redis (opcional para cache)
REDIS_URL=redis://localhost:6379

# Scheduler
SCHEDULER_ENABLED=True
SYNC_SCHEDULE_HOUR=6
SCHEDULER_TIMEZONE=America/Sao_Paulo

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001","http://localhost:8000","http://localhost:8001","http://127.0.0.1:8000","http://127.0.0.1:8001","https://seu-dominio.com"]

# API
API_V1_PREFIX=/api/v1
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# Logging
LOG_LEVEL=INFO
