# Google Ads Manager Configuration
# Copie este arquivo para .env e preencha com suas credenciais

# OAuth2 Credentials (Google Cloud Console)
GOOGLE_ADS_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_ADS_REFRESH_TOKEN=YOUR_REFRESH_TOKEN

# Google Ads API
GOOGLE_ADS_CUSTOMER_ID=000-000-0000
GOOGLE_ADS_DEVELOPER_TOKEN=YOUR_DEVELOPER_TOKEN

# PostgreSQL (para armazenar historico)
DB_HOST=seu_host_postgres
DB_PORT=5432
DB_NAME=seu_database
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# FastAPI Backend (opcional)
BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=sua_api_key

# Logging
LOG_LEVEL=INFO
