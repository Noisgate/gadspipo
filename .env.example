# ========================================
# BACKEND CONFIGURATION
# ========================================

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/marketing_manager?sslmode=disable
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20

# Auth & Security
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://seu-dominio.com/api/v1/auth/google/callback

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your-login-customer-id

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# App
DEBUG=false
FRONTEND_URL=https://seu-dominio.com
LOG_LEVEL=INFO
CORS_ORIGINS=https://seu-dominio.com,http://localhost:3000

# Scheduler
SCHEDULER_ENABLED=true
SYNC_SCHEDULE_HOUR=6

# ========================================
# FRONTEND CONFIGURATION
# ========================================

NEXT_PUBLIC_API_URL=https://api.seu-dominio.com

# ========================================
# DOCKER CONFIGURATION
# ========================================

# PostgreSQL
POSTGRES_USER=marketing
POSTGRES_PASSWORD=password
POSTGRES_DB=marketing_manager
POSTGRES_PORT=5432

# n8n (optional, if self-hosted)
# N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/marketing
